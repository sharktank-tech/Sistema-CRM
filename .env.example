# Copie este arquivo para `.env` e preencha os valores reais.
# Gere uma chave aleatória com: python -c "import secrets; print(secrets.token_hex(32))"

# ============== Ambiente =================
# development | testing | production
APP_ENV=development

# ============== Flask =================
SECRET_KEY=troque-por-um-valor-aleatorio
FLASK_APP=run

# ============== Database =================
# Para desenvolvimento com SQLite:
DATABASE_URL=sqlite:///database.db

# ============== Usuário administrador inicial =================
# Criado automaticamente no primeiro start se não existir nenhum usuário.
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=troque-por-uma-senha-forte

# ============== Dados de exemplo =================
# Semeia contatos, tarefas, interações e receitas de demonstração quando o banco está vazio.
SEED_DADOS_EXEMPLO=1